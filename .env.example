# Merge into the active Hermes profile's .env. Do not commit a real .env.
MANYCHAT_API_TOKEN=replace-with-manychat-page-api-token
MESSENGER_WEBHOOK_SECRET=replace-with-long-random-secret

# Start with your test contact's ManyChat ID.
MESSENGER_ALLOWED_USERS=123456789
MESSENGER_ALLOW_ALL_USERS=false

MESSENGER_HOST=0.0.0.0
MESSENGER_PORT=8788
MESSENGER_CAPACITY=1000
MESSENGER_RETENTION_SECONDS=604800
MESSENGER_API_TIMEOUT=20
MESSENGER_PROCESSING_TIMEOUT=600
# Default: <active Hermes home>/plugin-data/messenger/inbox.sqlite
# MESSENGER_DATABASE=C:/path/to/persistent/inbox.sqlite
